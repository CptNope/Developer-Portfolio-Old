				{
					"slug": "xx-large",
					"size": "2.5rem",
					"name": "2X Large",
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "huge",
					"size": "3rem",
					"name": "Huge",
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					}
				},
				{
					"slug": "gigantic",
					"size": "clamp(2.5rem, 7vw, 5rem)",
					"name": "Gigantic",
					"fluid": false
				}
			]
