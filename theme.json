				"shadow": true,
				"dimensions": {
					"aspectRatio": true
				}
			},
			"core/heading": {
				"typography": {
					"fontSizes": [],
					"customFontSize": true
				}
			},
			"core/paragraph": {
				"typography": {
					"fontSizes": [],
					"customFontSize": true
				}
			},
			"core/list": {
				"typography": {
					"fontSizes": [],
					"customFontSize": true
				}
			},
			"core/social-links": {
				"color": {
					"custom": true
				}
			}
		},
		"custom": {
			"fontWeight": {
				"light": 300,
				"regular": 400,
				"medium": 500,
				"semibold": 600,
				"bold": 700,
				"extrabold": 800
			},
			"borderRadius": {
				"sm": "0.375rem",
				"md": "0.5rem",
				"lg": "0.625rem",
				"xl": "0.75rem",
				"2xl": "1rem",
				"3xl": "1.5rem",
				"full": "9999px"
			},
			"gap": {
				"baseline": "1.5rem",
				"horizontal": "min(1.5rem, 4vw)",
				"vertical": "min(4rem, 8vh)"
			}
		}
