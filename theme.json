		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"spacing": {
			"customSpacingSize": true,
			"spacingScale": {
				"steps": 1
			},
			"spacingSizes": [
				{ "slug": "10", "size": "0.25rem", "name": "1" },
				{ "slug": "20", "size": "0.5rem", "name": "2" },
				{ "slug": "30", "size": "0.75rem", "name": "3" },
				{ "slug": "40", "size": "1rem", "name": "4" },
				{ "slug": "50", "size": "1.5rem", "name": "5" },
				{ "slug": "60", "size": "2rem", "name": "6" },
				{ "slug": "70", "size": "3rem", "name": "7" },
				{ "slug": "80", "size": "4rem", "name": "8" },
				{ "slug": "90", "size": "6rem", "name": "9" },
				{ "slug": "100", "size": "8rem", "name": "10" }
			],
			"units": ["%", "px", "em", "rem", "vh", "vw", "svh", "dvh"]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": true,
			"presets": [
				{
					"slug": "violet-sm",
					"name": "Violet Small",
					"shadow": "0 4px 14px rgba(139, 92, 246, 0.1)"
				},
				{
					"slug": "violet-md",
					"name": "Violet Medium",
					"shadow": "0 8px 25px rgba(139, 92, 246, 0.15)"
				},
				{
					"slug": "violet-lg",
					"name": "Violet Large",
					"shadow": "0 16px 40px rgba(139, 92, 246, 0.2)"
				},
				{
					"slug": "violet-xl",
					"name": "Violet XL",
					"shadow": "0 25px 60px rgba(139, 92, 246, 0.25)"
				}
			]
		},
