					"slug": "large",
					"size": "1.125rem",
					"name": "Large",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "x-large",
					"size": "1.5rem",
					"name": "Extra Large",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
