					"name": "Violet 600 to Cyan 600"
				},
				{
					"slug": "violet-glow",
					"gradient": "linear-gradient(135deg, rgba(139,92,246,0.1) 0%, transparent 50%, rgba(6,182,212,0.1) 100%)",
					"name": "Violet Glow"
