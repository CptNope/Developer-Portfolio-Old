{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "developer-portfolio/social-links",
	"version": "1.0.0",
	"title": "Social Links",
	"category": "theme",
	"icon": "share",
