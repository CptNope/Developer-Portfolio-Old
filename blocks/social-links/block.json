			"type": "string",
			"default": "https://www.linkedin.com/in/jeremy-anderson-53963b222/"
		},
		"xUrl": {
			"type": "string",
			"default": "https://x.com/JeremyA59964523"
		},
		"emailUrl": {
			"type": "string",
			"default": "mailto:info@jeremyanderson.tech"
		}
	},
	"textdomain": "developer-portfolio",
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
