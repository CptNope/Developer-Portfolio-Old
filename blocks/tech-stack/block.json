{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "developer-portfolio/tech-stack",
	"version": "1.0.0",
	"title": "Tech Stack",
	"category": "theme",
	"icon": "editor-code",
	"description": "Displays technology categories with colored badges from page meta.",
	"keywords": [ "tech", "stack", "skills", "technologies" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"usesContext": [ "postId", "postType" ],
	"textdomain": "developer-portfolio",
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
