{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "developer-portfolio/blog-listing",
	"version": "1.0.0",
	"title": "Blog Listing",
	"category": "theme",
	"icon": "admin-post",
	"description": "Full blog page listing with hero header, post cards, and pagination.",
	"keywords": [ "blog", "posts", "listing", "archive" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"sectionLabel": {
			"type": "string",
			"default": "// blog"
		},
		"heading": {
			"type": "string",
			"default": "Thoughts & Insights"
		},
		"headingHighlight": {
			"type": "string",
			"default": "Insights"
		},
		"description": {
			"type": "string",
			"default": "Writing about web development, software architecture, and the tools that make us more productive."
		},
		"perPage": {
			"type": "number",
			"default": 10
		}
	},
	"textdomain": "developer-portfolio",
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
